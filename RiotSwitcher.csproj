<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Khai báo đích danh OS version để chặn NuGet lùi về uap10.0 -->
		<TargetFramework>net8.0-windows10.0.17763.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ProduceReferenceAssembly>True</ProduceReferenceAssembly>
		<!-- Bắt đầu phần thông tin Details -->
		<Title>Riot Account Switcher</Title>
		<Description>Công cụ chuyển đổi tài khoản Riot siêu tốc có check rank</Description>
		<Product>Riot Account Switcher</Product>
		<Copyright>Copyright © 2026 by Shu Akashi. All rights reserved.</Copyright>
		<AssemblyVersion>1.0.2.0</AssemblyVersion>
		<FileVersion>1.0.2.0</FileVersion>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<RunPostBuildEvent>OnBuildSuccess</RunPostBuildEvent>
		<ApplicationManifest>app.manifest</ApplicationManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <DebugType>full</DebugType>
	  <IsPublishable>True</IsPublishable>
	  <Optimize>False</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <DebugType>full</DebugType>
	  <IsPublishable>True</IsPublishable>
	  <Optimize>True</Optimize>
	</PropertyGroup>

	<ItemGroup>
	  <Resource Include="logo.ico">
	    <CopyToOutputDirectory>Never</CopyToOutputDirectory>
	  </Resource>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FlaUI.UIA3" Version="4.0.0">
		  <PrivateAssets></PrivateAssets>
		</PackageReference>
	</ItemGroup>
	
</Project>